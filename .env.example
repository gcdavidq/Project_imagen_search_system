# ---------------------------------------------------------------------------
# Buscador multimodal de imágenes — configuración de entorno
# Copia este archivo a ".env" y ajusta los valores.
# ---------------------------------------------------------------------------

# Backend de búsqueda vectorial: "pgvector" (PostgreSQL, por defecto) o "faiss"
# (índice local en disco, no requiere base de datos; ideal para uso offline).
INDEX_BACKEND=pgvector

# --- PostgreSQL (solo si INDEX_BACKEND=pgvector) ----------------------------
# Opción A: cadena de conexión completa. Funciona con cualquier PostgreSQL que
# tenga la extensión pgvector: Neon, Supabase, Railway, Docker local, etc.
# Neon: Dashboard → Connect → copia la URI (usa el endpoint "-pooler").
#   postgresql://usuario:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Opción B: parámetros sueltos (se usan solo si DATABASE_URL está vacío).
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# --- Modelo CLIP (nomenclatura open-clip) ------------------------------------
# Multilingüe (español, inglés, etc.), 512 dimensiones. Cambiar de modelo
# implica reconstruir el índice con scripts/build_index.py.
MODEL_NAME=xlm-roberta-base-ViT-B-32
PRETRAINED=laion5b_s13b_b90k

# --- Datos -------------------------------------------------------------------
# Carpeta raíz de imágenes e índices. Por defecto: <raíz del proyecto>/data
DATA_DIR=

# Número de resultados por defecto.
TOP_K_DEFAULT=6

# --- Servidor ----------------------------------------------------------------
# Orígenes permitidos por CORS, separados por coma. "*" permite todos.
CORS_ORIGINS=*
