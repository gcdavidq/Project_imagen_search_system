# ---------------------------------------------------------------------------
# Multimodal Image Search — environment configuration
# Copy this file to ".env" and adjust as needed. All values have sensible
# defaults, so an empty/absent .env works out of the box.
# ---------------------------------------------------------------------------

# Root directory where images and the FAISS index are stored.
# Defaults to "<project_root>/data".
DATA_DIR=

# Default number of results returned by a search.
TOP_K_DEFAULT=6

# CLIP model architecture and pretrained weights (open-clip naming).
# Examples: ViT-B-32 / openai, ViT-L-14 / openai, ViT-B-16 / laion2b_s34b_b88k
MODEL_NAME=ViT-B-32
PRETRAINED=openai
